[sub_resource type="GDScript" id="GDScript_8r18l"]
script/source = "extends TileMapLayer


var GridSizeX = 6
var GridSizeY = 8
var Dic = {}

func _ready():
	
	for x in GridSizeX:
		for y in GridSizeY:
			Dic[str(Vector2(x,y))] = {
				\"Type\": \"Cell\",
				\"Position\": str(Vector2(x,y))
			}
			set_cell(Vector2(x, y), 0, Vector2i(0, 0), 0)

func _process(delta: float) -> void:
	var tile = local_to_map(get_global_mouse_position())
	set_cell(tile, 1, Vector2i(0, 0))

\"\"\"
func _process(delta):
	
	var tile = local_to_map(get_global_mouse_position())
	
	for x in GridSizeX:
		for y in GridSizeY:
			erase_cell(Vector2(x, y))
	
	if Dic.has(str(tile)):
		set_cell(tile, 1, Vector2i(0, 0), 0)
		print(Dic.str(tile))
\"\"\"
"

