[sub_resource type="GDScript" id="GDScript_8r18l"]
script/source = "extends TileMapLayer
@export var usable_tiles: Array[Vector2i] = [Vector2i(0,0), Vector2i(0,1), Vector2i(0,2), Vector2i(0,3), Vector2i(0,4), Vector2i(1,0), Vector2i(1,1), Vector2i(1,2), Vector2i(1,3), Vector2i(1,4), Vector2i(2,0), Vector2i(2,1), Vector2i(2,2), Vector2i(2,3), Vector2i(2,4), Vector2i(3,0), Vector2i(3,1), Vector2i(3,2), Vector2i(3,3), Vector2i(3,4), Vector2i(4,0), Vector2i(4,1), Vector2i(4,2), Vector2i(4,3), Vector2i(4,4), Vector2i(5,0), Vector2i(5,1), Vector2i(5,2), Vector2i(5,3), Vector2i(5,4), Vector2i(6,0), Vector2i(6,1), Vector2i(6,2), Vector2i(6,3), Vector2i(6,4), Vector2i(7,0), Vector2i(7,1), Vector2i(7,2), Vector2i(7,3), Vector2i(7,4), Vector2i(8,0), Vector2i(8,1), Vector2i(8,2), Vector2i(8,3), Vector2i(8,4), Vector2i(9,0), Vector2i(9,1), Vector2i(9,2), Vector2i(9,3), Vector2i(9,4)]
func is_tile_buildable(cell: Vector2i) -> bool:
	var tile_data: TileData = get_cell_tile_data(cell)
	# Return false immediately if there is no ground tile at this spot
	if not tile_data:
		return false
	var is_buildable: bool = tile_data.get_custom_data(\"mouse_position\")
	#Allows for checking if the current cell is one of the cells allowed for building
	if cell in usable_tiles:
		is_buildable = true
	return is_buildable
"

